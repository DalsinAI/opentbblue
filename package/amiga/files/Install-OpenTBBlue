; $VER: Install-OpenTBBlue 0.1.0 (4.11.2026)
; The Amiga Installer script for OpenTBBlue, a ZX Spectrum Next emulator.
; Run it from its icon, beside the OpenTBBlue drawer where the archive was unpacked.

(set @app-name "OpenTBBlue")
(set #version "0.1.0")
(set #drawer "OpenTBBlue")
(set #program "OpenTBBlue")
(set #space 255000)  ; KB

(onerror
    (message (cat "OpenTBBlue was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-OpenTBBlue again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "OpenTBBlue needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "OpenTBBlue needs a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The OpenTBBlue drawer is not beside Install-OpenTBBlue. Unpack the whole archive, then run Install-OpenTBBlue from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The OpenTBBlue drawer has no OpenTBBlue in it. Unpack the whole archive again."))

(welcome "This installs OpenTBBlue 0.1.0 for AmigaOS 3.2 on a 68040, 68060 or 68080.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:" (noreq)) 2) "Work:"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the OpenTBBlue drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called OpenTBBlue in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": OpenTBBlue needs 260 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "OpenTBBlue needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-OpenTBBlue again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
; copyfiles, not copylib: the module has no version string, and copylib
; leaves a file it cannot compare uncopied
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(if (and (not @pretend) (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1))
    (abort "SDL2.module could not be copied to LIBS:GFOpenGPU/. Nothing else has been installed."))
(complete 20)

; the network: gfopentls.library for HTTPS, its CA list, and curl in C:
; (the first start downloads System/Next with curl; OpenTBBlue uses the curl
; in its drawer, and C:curl is for the Shell). A newer library, a CA list
; or a curl already there is kept.
(set #net (tackon #source "Network"))
(if (<> (exists (tackon #net "Libs/gfopentls.library") (noreq)) 1)
    (abort "The Network drawer is not beside Install-OpenTBBlue. Unpack the whole archive, then run Install-OpenTBBlue again."))
(copylib
    (prompt "Copying gfopentls.library (HTTPS) to LIBS:")
    (help @copylib-help)
    (source (tackon #net "Libs/gfopentls.library"))
    (dest "LIBS:")
    (confirm "expert"))
(if (and (<> (exists "S:GFOpenTLS/ca-bundle.pem" (noreq)) 1)
         (= (exists (tackon #net "S/GFOpenTLS/ca-bundle.pem") (noreq)) 1))
    (copyfiles
        (prompt "Copying the CA list for HTTPS to S:GFOpenTLS/")
        (help @copyfiles-help)
        (source (tackon #net "S/GFOpenTLS"))
        (dest "S:GFOpenTLS")
        (choices "ca-bundle.pem")))
(if (<> (exists "C:curl" (noreq)) 1)
    (copyfiles
        (prompt "Copying curl to C:")
        (help @copyfiles-help)
        (source (tackon #from "curl"))
        (dest "C:")))
(complete 30)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "OpenTBBlue-data") (noreq))
    (set #kept (if (= #kept "") "OpenTBBlue-data" (cat #kept "|" "OpenTBBlue-data"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying OpenTBBlue")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating OpenTBBlue. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "OpenTBBlue.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "OpenTBBlue.info")))

(set @default-dest #dest)
(complete 90)

; System/Next, the Next's own software (about 100 MB, with curl): now, or on
; the first start
(set #card (tackon #dest "OpenTBBlue-data/drives/SD0/TBBLUE.FW"))
(if (and (not @pretend) (<> (exists #card (noreq)) 1))
    (if (askbool
            (prompt "Download System/Next now? It is the Next's own software, about 100 MB, and the network must be up. Otherwise OpenTBBlue downloads it on its first start.")
            (help "OpenTBBlue runs curl to fetch the latest System/Next distribution and writes its files to the first SD card, OpenTBBlue-data/drives/SD0. A window shows how far it has got.")
            (choices "Download now" "On the first start")
            (default 1))
        (
            (textfile
                (dest "T:OpenTBBlue-fetch")
                (append (cat "Stack 262144\n\"" (tackon #dest #program) "\" --fetch\n")))
            (set #got (execute "T:OpenTBBlue-fetch" (safe)))
            (delete "T:OpenTBBlue-fetch" (safe))
            (if (<> (exists #card (noreq)) 1)
                (message "System/Next was not downloaded (is the network up?). OpenTBBlue tries again on its first start.")))))
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. OpenTBBlue would have gone in " #dest "."))
    (message (cat "OpenTBBlue 0.1.0 is installed in " #dest "."
                  "\n\nTo start it, open the OpenTBBlue drawer and double-click the OpenTBBlue icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
